"DeviceAddress"=dword:5c
"MaxSpeed"=dword:270f		; 9999
"MinSpeed"=dword:3e8		; 1000
"Percentage"=dword:46
"IndexTachL"=dword:2c		; Tach 1
"IndexStatus"=dword:42
"TachClock"=dword:5265c0
"status_bitmask"=dword:4
"FullSpeedDeviceType"=dword:2
"IndexFullspeed"=dword:80
"fullspeed_bitmask"=dword:e0
"fullspeed_value"=dword:60
"FanTachLimitIndexL"=dword:62
"FanTachLimit"=dword:fff0

