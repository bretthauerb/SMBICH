[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscCmos.cat
DriverVer=09/11/2013,6.0.1.3

[Manufacturer]
%MFGNAME%=DeviceList, NTx86, NTamd64

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
FscCmos.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscCmos.sys,,

[DeviceList.NTx86]
%DESCRIPTION% = DriverInstall, Root\FscCmos

[DeviceList.NTamd64]
%DESCRIPTION% = DriverInstall, Root\FscCmos

[DriverInstall.NTx86]
CopyFiles=DriverCopyFiles

[DriverInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscCmos.sys,,,2

[DriverInstall.NTx86.Services]
AddService = FscCmos, 2, ServiceInstall

[DriverInstall.NTamd64.Services]
AddService = FscCmos, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscCmos.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu Cmos access"
