[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscGabi.cat
DriverVer=01/26/2016,6.1.0.0

[Manufacturer]
%MFGNAME%=DeviceList, NTx86, NTamd64

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
FscGabi.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscGabi.sys,,

[DeviceList.NTx86]
%DESCRIPTION% = DriverInstall, Root\FscGabi
%DESCRIPTION% = DriverInstall, ACPI\IBAG

[DeviceList.NTamd64]
%DESCRIPTION% = DriverInstall, Root\FscGabi
%DESCRIPTION% = DriverInstall, ACPI\IBAG

[DriverInstall.NTx86]
CopyFiles=DriverCopyFiles

[DriverInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscGabi.sys,,,2

[DriverInstall.NTx86.Services]
AddService = FscGabi, 2, ServiceInstall

[DriverInstall.NTamd64.Services]
AddService = FscGabi, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscGabi.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu gabi bios interface"
