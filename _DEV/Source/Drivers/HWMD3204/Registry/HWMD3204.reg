Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg]

;[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Intrusion]
;[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Intrusion\1]
; Use GABI
;"SwitchDeviceType"=dword:00000005
;"IntrusionDeviceType"=dword:00000005

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Fan]
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Fan\1]
; FanConnector 1, Theseus device
"Where"=dword:2001
"DeviceType"=dword:6
"DeviceAddress"=dword:5c
"MaxSpeed"=dword:270f		; 9999
"MinSpeed"=dword:3e8		; 1000
"Percentage"=dword:46
"IndexTachL"=dword:2c
"IndexStatus"=dword:880
"TachClock"=dword:5265c0


[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Volt]
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Volt\1]
; VBatt, HeCeTa device
"Where"=dword:1
"DeviceType"=dword:2
"DeviceAddress"=dword:5c
"RegisterIndex"=dword:24
"Multiplier"=dword:3d08
"Offset"=dword:0
"HighLimit"=dword:387520 ; 3.70 V
"LowLimit"=dword:256250  ; 2.45 V


[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Temp]
