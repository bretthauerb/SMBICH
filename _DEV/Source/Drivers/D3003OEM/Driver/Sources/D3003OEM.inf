[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=D3003OEM.cat
DriverVer=10/11/2013,6.0.1.18

[Manufacturer]
%MFGNAME%=DeviceList, NTx86, NTamd64

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
D3003OEM.sys=1

[SourceDisksNames]
1=%INSTDISK%,D3003OEM.sys,,

[DeviceList.NTx86]
%DESCRIPTION% = DriverInstall, Root\D3003OEM

[DeviceList.NTamd64]
%DESCRIPTION% = DriverInstall, Root\D3003OEM

[DriverInstall.NTx86]
CopyFiles=DriverCopyFiles

[DriverInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
D3003OEM.sys,,,2

[DriverInstall.NTx86.Services]
AddService = D3003OEM, 2, ServiceInstall

[DriverInstall.NTamd64.Services]
AddService = D3003OEM, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\D3003OEM.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="GPIO and Watchdog driver for AMD Hudson/Kabini chipset"
