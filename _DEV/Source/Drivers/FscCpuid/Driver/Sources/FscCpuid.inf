[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscCpuid.cat
DriverVer=07/21/2016,6.2.0.0

[Manufacturer]
%MFGNAME%=DeviceList, NT$ARCH$

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
FscCpuid.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscCpuid.sys,,

[DeviceList.NT$ARCH$]
%DESCRIPTION% = DriverInstall, Root\FscCpuid

[DriverInstall.NT$ARCH$]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscCpuid.sys,,,2

[DriverInstall.NT$ARCH$.Services]
AddService = FscCpuid, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscCpuid.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu CPUID Access"
