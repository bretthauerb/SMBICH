[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=SCH5627AMD.cat
DriverVer=10/11/2013,6.0.1.7

[Manufacturer]
%MFGNAME%=DeviceList, NTx86, NTamd64

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
SCH5627AMD.sys=1

[SourceDisksNames]
1=%INSTDISK%,SCH5627AMD.sys,,

[DeviceList.NTx86]
%DESCRIPTION% = DriverInstall, Root\SCH5627AMD

[DeviceList.NTamd64]
%DESCRIPTION% = DriverInstall, Root\SCH5627AMD

[DriverInstall.NTx86]
CopyFiles=DriverCopyFiles

[DriverInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
SCH5627AMD.sys,,,2

[DriverInstall.NTx86.Services]
AddService = SCH5627AMD, 2, ServiceInstall

[DriverInstall.NTamd64.Services]
AddService = SCH5627AMD, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\SCH5627AMD.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu SCH5627 based system monitoring"
