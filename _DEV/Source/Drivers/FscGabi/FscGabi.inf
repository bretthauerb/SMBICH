[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscGabi.cat
DriverVer=03/02/2016,6.2.2.0

[Manufacturer]
%MFGNAME%=DeviceList, NT$ARCH$

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
FscGabi.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscGabi.sys,,

[DeviceList.NT$ARCH$]
%DESCRIPTION% = DriverInstall, Root\FscGabi
%DESCRIPTION% = DriverInstall, ACPI\IBAG

[DriverInstall.NT$ARCH$]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscGabi.sys,,,2

[DriverInstall.NT$ARCH$.Services]
AddService = FscGabi, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscGabi.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu GABI BIOS Interface"
