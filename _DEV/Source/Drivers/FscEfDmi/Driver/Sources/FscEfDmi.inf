[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscEfDmi.cat
DriverVer=07/21/2016,6.2.0.0

[Manufacturer]
%MFGNAME%=DeviceList,NT$ARCH$

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
FscEfDmi.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscEfDmi.sys,,

[DeviceList.NT$ARCH$]
%DESCRIPTION% = DriverInstall, Root\FscEfDmi

[DriverInstall.NT$ARCH$]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscEfDmi.sys,,,2

[DriverInstall.NT$ARCH$.Services]
AddService = FscEfDmi, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscEfDmi.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu DMI Access"
