Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg]

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Intrusion]
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Intrusion\1]
; Use GABI
"SwitchDeviceType"=dword:00000005
"IntrusionDeviceType"=dword:00000005

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Fan]
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\FscHWMonCfg\Fan\1]
; FanConnector 1, Charites device
"Where"=dword:4
"DeviceType"=dword:a
"DeviceAddress"=dword:5c
"MaxSpeed"=dword:270f		; 9999
"MinSpeed"=dword:3e8		; 1000
"Percentage"=dword:46
"PageSelect"=dword:4e
"IndexTachL"=dword:c1
"PWMPage"=dword:1
"PWMIndex"=dword:27
"FanPage"=dword:4

