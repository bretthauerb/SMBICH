[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=SmbIch.cat
DriverVer=07/24/2020,6.4.0.0

[Manufacturer]
%MFGNAME%=DeviceList,NT$ARCH$

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
SmbIch.sys=1

[SourceDisksNames]
1=%INSTDISK%,SmbIch.sys,,

[DeviceList.NT$ARCH$]
%DESCRIPTION_ICH%=DriverInstall,PCI\VEN_8086&DEV_2413
%DESCRIPTION_ICH0%=DriverInstall,PCI\VEN_8086&DEV_2423
%DESCRIPTION_ICH2%=DriverInstall,PCI\VEN_8086&DEV_2443
%DESCRIPTION_ICH4%=DriverInstall,PCI\VEN_8086&DEV_24C3
%DESCRIPTION_ICH5%=DriverInstall,PCI\VEN_8086&DEV_24D3
%DESCRIPTION_ICH6%=DriverInstall,PCI\VEN_8086&DEV_266A
%DESCRIPTION_ICH7%=DriverInstall,PCI\VEN_8086&DEV_27DA
%DESCRIPTION_ICH8%=DriverInstall,PCI\VEN_8086&DEV_283E
%DESCRIPTION_ICH9%=DriverInstall,PCI\VEN_8086&DEV_2930
%DESCRIPTION_ESB2%=DriverInstall,PCI\VEN_8086&DEV_269B
%DESCRIPTION_WSB%=DriverInstall,PCI\VEN_8086&DEV_8D22
%DESCRIPTION_SKY%=DriverInstall,PCI\VEN_8086&DEV_A123
%DES_SMB_INTEL_LEWISBURG1%=DriverInstall,PCI\VEN_8086&DEV_A1A3
%DES_SMB_INTEL_LEWISBURG2%=DriverInstall,PCI\VEN_8086&DEV_A223
%DESCRIPTION_KAB%=DriverInstall,PCI\VEN_8086&DEV_A2A3
%DESCRIPTION_COF%=DriverInstall,PCI\VEN_8086&DEV_A323
%DES_SMB_INTEL_GEMINILAKE%=DriverInstall,PCI\VEN_8086&DEV_31D4
%DESCRIPTION_COM%=DriverInstall,PCI\VEN_8086&DEV_06A3
%DESCRIPTION_COM2%=DriverInstall,PCI\VEN_8086&DEV_A3A3

[DriverInstall.NT$ARCH$]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
SmbIch.sys,,,2

[DriverInstall.NT$ARCH$.Services]
AddService=SmbIch,2,DriverService

[DriverService]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%10%\system32\drivers\SmbIch.sys

[DriverInstall.NT$ARCH$.hw]
AddReg=DriverHwAddReg

[DriverHwAddReg]
HKR,,FriendlyName,,%FRIENDLYNAME%

