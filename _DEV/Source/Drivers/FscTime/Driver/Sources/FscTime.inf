[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscTime.cat
DriverVer=09/11/2013,6.0.1.5

[Manufacturer]
%MFGNAME%=DeviceList,NT$ARCH$

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
FscTime.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscTime.sys,,

[DeviceList.NT$ARCH$]
%DESCRIPTION% = DriverInstall, Root\FscTime

[DriverInstall.NT$ARCH$]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscTime.sys,,,2

[DriverInstall.NT$ARCH$.Services]
AddService = FscTime, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscTime.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu System Runtime Counter"
