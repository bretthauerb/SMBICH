[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscCmos.cat
DriverVer=07/21/2016,6.2.0.0

[Manufacturer]
%MFGNAME%=DeviceList, NT$ARCH$

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksFiles]
FscCmos.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscCmos.sys,,

[DeviceList.NT$ARCH$]
%DESCRIPTION% = DriverInstall, Root\FscCmos


[DriverInstall.NT$ARCH$]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscCmos.sys,,,2

[DriverInstall.NT$ARCH$.Services]
AddService = FscCmos, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscCmos.sys

[Strings]
MFGNAME="Fujitsu"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu CMOS Access"
