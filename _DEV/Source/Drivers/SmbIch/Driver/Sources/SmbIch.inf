[DriverInstall.NT]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
SmbIch.sys

;-------------- Service installation
[DriverInstall.NT.Services]
AddService=SmbIch,2,DriverService

[DriverService]
DisplayName=%SVCDESC%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\SmbIch.sys

[DriverInstall.NT.hw]
AddReg=DriverHwAddReg

[DriverHwAddReg]
HKR,,FriendlyName,,%FRIENDLYNAME%

