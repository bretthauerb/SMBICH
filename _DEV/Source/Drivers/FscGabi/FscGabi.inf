[Version]
Signature=$WINDOWS NT$
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%MFGNAME%
CatalogFile=FscGabi.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages
PnpLockdown=1

[Manufacturer]
%MFGNAME%=DeviceList, NTamd64.10.0...17134

[DestinationDirs]
DefaultDestDir=12

[SourceDisksFiles]
FscGabi.sys=1

[SourceDisksNames]
1=%INSTDISK%,FscGabi.sys,,

[DeviceList.NTamd64.10.0...17134]
%DESCRIPTION% = DriverInstall.NTamd64.10.0...17134, Root\FscGabi


[DriverInstall.NTamd64.10.0...17134]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
FscGabi.sys,,,2

[DriverInstall.NTamd64.10.0...17134.Services]
AddService = FscGabi, 2, ServiceInstall

[ServiceInstall]

ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\FscGabi.sys

[Strings]
MFGNAME="Fujitsu Client Computing Limited"
INSTDISK="Fujitsu Installation Disc"
DESCRIPTION="Fujitsu GABI BIOS Interface"
