"RegisterIndex"=dword:18
"Multiplier"=dword:379b
"Offset"=dword:0
"HighLimit"=dword:36ee80 ; 3.6 V
"LowLimit"=dword:2dc6c0	 ; 3.0 V
"PageSelect"=dword:7f
"RegisterPage"=dword:0

